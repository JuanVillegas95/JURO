{
  "name": "juro-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port ${JURO_FRONTEND_PORT:-5173}",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "server:dev": "npm --prefix ../server run dev",
